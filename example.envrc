# Copy to .envrc and fill in. `direnv allow` loads it into the shell; the MCP server and the
# CLI both read the exported environment. Never commit the filled-in copy.

export OPENAI_API_KEY=sk-...
export BLUE_DATA_REGISTRY_PATH="$PWD/data/registry.json"

# Optional — each falls back to the default in blue_data_planner.settings.PlannerSettings.
# export BLUE_DATA_PLANNER_MODEL=openai/gpt-6-luna
# export BLUE_DATA_PLANNER_REASONING_EFFORT=low
# export BLUE_DATA_PLANNER_OPERATORS=builtin,lotus
# export BLUE_DATA_PLANNER_LOTUS_MODEL=openai/gpt-4.1
# export BLUE_DATA_PLANNER_LOTUS_REASONING_EFFORT=none
# export BLUE_DATA_PLANNER_LOTUS_MAX_ROWS=5000
# export BLUE_DATA_PLANNER_MAX_OPERATOR_CALLS=30
# export BLUE_DATA_PLANNER_MAX_FAILURE_REPLANS=2
# export BLUE_DATA_PLANNER_MAX_CONTROL_REPLANS=5
